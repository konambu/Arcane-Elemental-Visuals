// Native Kenshi flame/smoke textures, Circle emitters and Vortex affectors.
// Dimensions are game units: Whirlwind radius30, visual height about70.
// Packed billboard colours must stay <=1: larger values wrap instead of adding HDR.
system AEV_FireVortex
{
    category kenshi_particles
    technique DustFoot
    {
        visual_particle_quota 36
        material kenshi_smoke1
        renderer Billboard
        {
            render_queue_group 84
        }
        emitter Circle GroundDust
        {
            emission_rate 32
            direction 0 1 0
            angle 10
            radius 22
            position 0 1 0
            keep_local true
            time_to_live dyn_random
            {
                min 0.45
                max 0.85
            }
            velocity dyn_random
            {
                min 6
                max 12
            }
            all_particle_dimensions dyn_random
            {
                min 12
                max 20
            }
            colour 0.55 0.38 0.22 0.22
        }
        affector Vortex
        {
            rotation_axis 0 1 0
            rotation_speed 4.4
        }
        affector Colour
        {
            time_colour 0 1 1 1 0
            time_colour 0.16 1 1 1 1
            time_colour 1 1 1 1 0
            colour_operation multiply
        }
        affector TextureRotator
        {
            rotation_speed 0.6
        }
    }
    technique FlameHelix
    {
        visual_particle_quota 128
        material Flame1
        renderer Billboard
        {
            render_queue_group 84
        }
        emitter Circle LowerFlames
        {
            emission_rate 36
            direction 0 1 0
            angle 0
            radius 6
            position 0 1 0
            emit_random false
            step 0.02
            keep_local true
            time_to_live dyn_random
            {
                min 0.9
                max 1.1
            }
            velocity dyn_random
            {
                min 45
                max 52
            }
            particle_width dyn_random
            {
                min 9
                max 12
            }
            particle_height dyn_random
            {
                min 14
                max 20
            }
        }
        emitter Circle MiddleFlames
        {
            emission_rate 32
            direction 0 1 0
            angle 0
            radius 13
            position 0 18 0
            emit_random false
            step 0.0225
            circle_em_angle 2
            keep_local true
            time_to_live dyn_random
            {
                min 0.7
                max 0.9
            }
            velocity dyn_random
            {
                min 35
                max 42
            }
            particle_width dyn_random
            {
                min 11
                max 16
            }
            particle_height dyn_random
            {
                min 15
                max 22
            }
        }
        emitter Circle UpperFlames
        {
            emission_rate 26
            direction 0 1 0
            angle 0
            radius 22
            position 0 39 0
            emit_random false
            step 0.0276923
            circle_em_angle 4.3
            keep_local true
            time_to_live dyn_random
            {
                min 0.5
                max 0.7
            }
            velocity dyn_random
            {
                min 22
                max 30
            }
            particle_width dyn_random
            {
                min 12
                max 18
            }
            particle_height dyn_random
            {
                min 16
                max 23
            }
        }
        affector Vortex
        {
            rotation_axis 0 1 0
            rotation_speed 6
        }
        affector Colour
        {
            time_colour 0 0.65 0.08 0.005 0
            time_colour 0.1 1 0.32 0.035 1
            time_colour 0.45 1 0.22 0.015 1
            time_colour 0.8 0.42 0.035 0.002 0.5
            time_colour 1 0 0 0 0
        }
        affector TextureRotator
        {
            rotation_speed 0.25
        }
    }
    technique HotWisps
    {
        visual_particle_quota 48
        material kenshi_smoke2_add
        renderer Billboard
        {
            render_queue_group 84
        }
        emitter Circle HotAir
        {
            emission_rate 42
            direction 0 1 0
            angle 5
            radius 9
            position 0 2 0
            keep_local true
            time_to_live dyn_random
            {
                min 0.7
                max 1
            }
            velocity dyn_random
            {
                min 48
                max 60
            }
            all_particle_dimensions dyn_random
            {
                min 8
                max 13
            }
        }
        affector Vortex
        {
            rotation_axis 0 1 0
            rotation_speed 7
        }
        affector Colour
        {
            time_colour 0 0 0 0 0
            time_colour 0.15 0.7 0.15 0.01 1
            time_colour 0.5 0.5 0.055 0.002 1
            time_colour 1 0 0 0 0
        }
        affector TextureRotator
        {
            rotation_speed 0.6
        }
    }
    technique SmokeCrown
    {
        visual_particle_quota 36
        material kenshi_smoke1
        renderer Billboard
        {
            render_queue_group 84
        }
        emitter Circle Crown
        {
            emission_rate 24
            direction 0 1 0
            angle 10
            radius 18
            position 0 40 0
            keep_local true
            time_to_live dyn_random
            {
                min 0.65
                max 1.1
            }
            velocity dyn_random
            {
                min 8
                max 16
            }
            all_particle_dimensions dyn_random
            {
                min 13
                max 22
            }
            colour 0.16 0.12 0.08 0.12
        }
        affector Vortex
        {
            rotation_axis 0 1 0
            rotation_speed 4
        }
        affector Colour
        {
            time_colour 0 1 1 1 0
            time_colour 0.15 1 1 1 1
            time_colour 1 1 1 1 0
            colour_operation multiply
        }
    }
    technique RisingEmbers
    {
        visual_particle_quota 64
        material AEV_EmberMat
        renderer Billboard
        {
            render_queue_group 84
        }
        emitter Circle Embers
        {
            emission_rate 45
            direction 0 1 0
            angle 15
            radius 12
            position 0 4 0
            keep_local true
            time_to_live dyn_random
            {
                min 0.5
                max 1.1
            }
            velocity dyn_random
            {
                min 35
                max 55
            }
            all_particle_dimensions dyn_random
            {
                min 0.45
                max 1.1
            }
        }
        affector Vortex
        {
            rotation_axis 0 1 0
            rotation_speed 8
        }
        affector Colour
        {
            time_colour 0 1 0.4 0.05 0
            time_colour 0.08 1 0.4 0.05 1
            time_colour 0.7 1 0.12 0.005 1
            time_colour 1 0 0 0 0
        }
    }
}
